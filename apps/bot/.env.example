# Copy to .env (or an EnvironmentFile for systemd) and fill in.
# The TOKEN is the only secret. The application id and public key shown in the
# developer portal are public identifiers and are not needed here; this bot
# connects over the gateway and only authenticates with the token.
DISCORD_TOKEN=paste-bot-token-here
# Optional: which application counts as Dundor. Defaults to the public id.
# DUNDOR_APP_ID=1284876985822216232
